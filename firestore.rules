rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function favoriteCountPath(productId) {
      return /databases/$(database)/documents/productFavoriteCounts/$(productId);
    }

    function favoriteVoterPath(productId, userId) {
      return /databases/$(database)/documents/productFavorites/$(productId)/voters/$(userId);
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "littleban0305@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /siteSettings/faq {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["items"])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if false;
    }

    function validListing(data) {
      return data.keys().hasOnly(["name", "game", "category", "description", "price", "stock", "tags", "imageUrl", "source", "steam", "listed", "createdAt", "updatedAt"])
        && data.keys().hasAll(["name", "game", "category", "description", "price", "stock", "tags", "imageUrl", "source", "listed", "createdAt"])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.game in ["CS2", "ROBLOX RIVALS"]
        && data.category is string && data.category.size() <= 30
        && data.description is string && data.description.size() <= 500
        && (data.price == null || (data.price is int && data.price >= 0 && data.price <= 10000000))
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && data.tags is list && data.tags.size() <= 10
        && data.imageUrl is string && data.imageUrl.size() <= 2048
        && (data.imageUrl == "" || data.imageUrl.matches("^https://.+"))
        && data.source in ["custom", "steam"]
        && data.listed is bool
        && data.createdAt is int;
    }

    match /listings/{listingId} {
      allow read: if resource.data.listed == true || isAdmin();
      allow create, update: if isAdmin() && validListing(request.resource.data);
      allow delete: if isAdmin();
    }

    function validOrderCreate(data) {
      return data.keys().hasOnly(["type", "uid", "buyerName", "tradeUrl", "items", "offerItems", "total", "offerTotal", "note", "adminNote", "status", "createdAt", "updatedAt"])
        && data.keys().hasAll(["type", "uid", "buyerName", "tradeUrl", "items", "offerItems", "total", "offerTotal", "note", "adminNote", "status", "createdAt", "updatedAt"])
        && data.type in ["purchase", "trade"]
        && data.uid == request.auth.uid
        && data.buyerName is string && data.buyerName.size() <= 30
        && data.tradeUrl is string && data.tradeUrl.size() <= 200
        && data.items is list && data.items.size() > 0 && data.items.size() <= 30
        && data.offerItems is list && data.offerItems.size() <= 20
        && (data.type == "trade" || data.offerItems.size() == 0)
        && data.total is int && data.total >= 0
        && data.offerTotal is int && data.offerTotal >= 0
        && data.note is string && data.note.size() <= 500
        && data.adminNote == ""
        && data.status == "pending"
        && data.createdAt is int && data.updatedAt is int;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && validOrderCreate(request.resource.data);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "adminNote", "updatedAt"])
          && request.resource.data.status in ["pending", "processing", "completed", "cancelled"]
          && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 300)
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "cancelled");
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["to", "from", "title", "body", "link", "orderId", "read", "createdAt"])
        && request.resource.data.keys().hasAll(["to", "from", "title", "body", "link", "orderId", "read", "createdAt"])
        && request.resource.data.from == request.auth.uid
        && (request.resource.data.to == "admin" || isAdmin())
        && request.resource.data.to is string && request.resource.data.to.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 300
        && request.resource.data.link is string && request.resource.data.link.size() <= 100
        && request.resource.data.orderId is string && request.resource.data.orderId.size() <= 100
        && request.resource.data.read == false
        && request.resource.data.createdAt is int;
      allow update: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read == true;
      allow delete: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()));
    }

    match /wallets/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["balance", "updatedAt"])
        && request.resource.data.balance is int && request.resource.data.balance >= 0
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    match /walletTransactions/{entryId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["uid", "amount", "balanceAfter", "type", "refId", "note", "createdAt"])
        && request.resource.data.amount is int
        && request.resource.data.balanceAfter is int && request.resource.data.balanceAfter >= 0
        && request.resource.data.type in ["topup", "purchase", "trade", "adjust"]
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    match /topups/{topupId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["uid", "userName", "message", "requestedAmount", "attachmentCount", "status", "creditedAmount", "adminNote", "createdAt", "updatedAt"])
        && request.resource.data.keys().hasAll(["uid", "userName", "message", "requestedAmount", "attachmentCount", "status", "creditedAmount", "adminNote", "createdAt", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.requestedAmount is int && request.resource.data.requestedAmount >= 0
        && request.resource.data.attachmentCount is int && request.resource.data.attachmentCount >= 0 && request.resource.data.attachmentCount <= 3
        && request.resource.data.status == "pending"
        && request.resource.data.creditedAmount == 0
        && request.resource.data.adminNote == ""
        && request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "creditedAmount", "adminNote", "updatedAt"])
          && request.resource.data.status in ["pending", "approved", "rejected", "cancelled"]
          && request.resource.data.creditedAmount is int && request.resource.data.creditedAmount >= 0
          && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 300)
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "cancelled");
      allow delete: if false;

      match /attachments/{attachmentId} {
        allow read: if isAdmin()
          || (request.auth != null && get(/databases/$(database)/documents/topups/$(topupId)).data.uid == request.auth.uid);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/topups/$(topupId)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/topups/$(topupId)).data.status == "pending"
          && attachmentId in ["0", "1", "2"]
          && request.resource.data.keys().hasOnly(["dataUrl", "name", "createdAt"])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 900000
          && request.resource.data.dataUrl.matches("^data:image/(jpeg|png|webp);base64,.*")
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.createdAt is int;
        allow update, delete: if false;
      }
    }

    // 每位使用者自己的 SteamAnalyst 金鑰，只有本人讀寫
    match /userSecrets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["steamAnalystKey", "updatedAt"])
        && request.resource.data.steamAnalystKey is string
        && request.resource.data.steamAnalystKey.size() <= 200
        && (request.resource.data.steamAnalystKey == "" || request.resource.data.steamAnalystKey.matches("^sa_[A-Za-z0-9_-]{8,190}$"))
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // SteamAnalyst 查到的價格，大家共用；usd 為 0 代表查無此物品
    match /marketPrices/{priceId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != "anonymous"
        && request.resource.data.keys().hasOnly(["name", "usd", "source", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["name", "usd", "source", "updatedAt", "updatedBy"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 300
        && request.resource.data.usd is number
        && request.resource.data.usd >= 0
        && request.resource.data.usd <= 1000000
        && request.resource.data.source == "steamanalyst"
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["displayName", "tradeUrl"])
        && request.resource.data.keys().hasAll(["displayName", "tradeUrl"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.tradeUrl is string
        && request.resource.data.tradeUrl.matches("^https://steamcommunity\\.com/tradeoffer/new/\\?(partner=[0-9]+&token=[A-Za-z0-9_-]+|token=[A-Za-z0-9_-]+&partner=[0-9]+)$");
      allow delete: if false;
    }

    match /productFavoriteCounts/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && existsAfter(favoriteVoterPath(productId, request.auth.uid))
        && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && resource.data.count is int
        && (
          (request.resource.data.count == resource.data.count + 1
            && !exists(favoriteVoterPath(productId, request.auth.uid))
            && existsAfter(favoriteVoterPath(productId, request.auth.uid))
            && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid)
          ||
          (request.resource.data.count == resource.data.count - 1
            && exists(favoriteVoterPath(productId, request.auth.uid))
            && get(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid
            && !existsAfter(favoriteVoterPath(productId, request.auth.uid)))
        );
      allow delete: if false;
    }

    match /productFavorites/{productId}/voters/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && (
          (!exists(favoriteCountPath(productId))
            && existsAfter(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == 1)
          ||
          (exists(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count + 1)
        );
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && exists(favoriteCountPath(productId))
        && get(favoriteCountPath(productId)).data.count is int
        && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count - 1;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
