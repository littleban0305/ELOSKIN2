rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function favoriteCountPath(productId) {
      return /databases/$(database)/documents/productFavoriteCounts/$(productId);
    }

    function favoriteVoterPath(productId, userId) {
      return /databases/$(database)/documents/productFavorites/$(productId)/voters/$(userId);
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "littleban0305@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /siteSettings/faq {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["items"])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if false;
    }

    function validListing(data) {
      return data.keys().hasOnly(["name", "game", "category", "description", "price", "stock", "tags", "imageUrl", "source", "steam", "listed", "createdAt", "updatedAt"])
        && data.keys().hasAll(["name", "game", "category", "description", "price", "stock", "tags", "imageUrl", "source", "listed", "createdAt"])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.game in ["CS2", "ROBLOX RIVALS"]
        && data.category is string && data.category.size() <= 30
        && data.description is string && data.description.size() <= 500
        && (data.price == null || (data.price is int && data.price >= 0 && data.price <= 10000000))
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && data.tags is list && data.tags.size() <= 10
        && data.imageUrl is string && data.imageUrl.size() <= 2048
        && (data.imageUrl == "" || data.imageUrl.matches("^https://.+"))
        && data.source in ["custom", "steam"]
        && data.listed is bool
        && data.createdAt is int;
    }

    match /listings/{listingId} {
      allow read: if resource.data.listed == true || isAdmin();
      allow create, update: if isAdmin() && validListing(request.resource.data);
      allow delete: if isAdmin();
    }

    function validOrderCreate(data) {
      return data.keys().hasOnly(["type", "uid", "buyerName", "tradeUrl", "items", "offerItems", "total", "offerTotal", "note", "adminNote", "status", "createdAt", "updatedAt"])
        && data.keys().hasAll(["type", "uid", "buyerName", "tradeUrl", "items", "offerItems", "total", "offerTotal", "note", "adminNote", "status", "createdAt", "updatedAt"])
        && data.type in ["purchase", "trade"]
        && data.uid == request.auth.uid
        && data.buyerName is string && data.buyerName.size() <= 30
        && data.tradeUrl is string && data.tradeUrl.size() <= 200
        && data.items is list && data.items.size() > 0 && data.items.size() <= 30
        && data.offerItems is list && data.offerItems.size() <= 20
        && (data.type == "trade" || data.offerItems.size() == 0)
        && data.total is int && data.total >= 0
        && data.offerTotal is int && data.offerTotal >= 0
        && data.note is string && data.note.size() <= 500
        && data.adminNote == ""
        && data.status == "pending"
        && data.createdAt is int && data.updatedAt is int;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && validOrderCreate(request.resource.data);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "adminNote", "updatedAt"])
          && request.resource.data.status in ["pending", "processing", "completed", "cancelled"]
          && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 300)
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "cancelled");
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["to", "from", "title", "body", "link", "orderId", "read", "createdAt"])
        && request.resource.data.keys().hasAll(["to", "from", "title", "body", "link", "orderId", "read", "createdAt"])
        && request.resource.data.from == request.auth.uid
        && (request.resource.data.to == "admin" || isAdmin())
        && request.resource.data.to is string && request.resource.data.to.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 300
        && request.resource.data.link is string && request.resource.data.link.size() <= 100
        && request.resource.data.orderId is string && request.resource.data.orderId.size() <= 100
        && request.resource.data.read == false
        && request.resource.data.createdAt is int;
      allow update: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read == true;
      allow delete: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()));
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["displayName", "tradeUrl"])
        && request.resource.data.keys().hasAll(["displayName", "tradeUrl"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.tradeUrl is string
        && request.resource.data.tradeUrl.matches("^https://steamcommunity\\.com/tradeoffer/new/\\?(partner=[0-9]+&token=[A-Za-z0-9_-]+|token=[A-Za-z0-9_-]+&partner=[0-9]+)$");
      allow delete: if false;
    }

    match /productFavoriteCounts/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && existsAfter(favoriteVoterPath(productId, request.auth.uid))
        && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && resource.data.count is int
        && (
          (request.resource.data.count == resource.data.count + 1
            && !exists(favoriteVoterPath(productId, request.auth.uid))
            && existsAfter(favoriteVoterPath(productId, request.auth.uid))
            && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid)
          ||
          (request.resource.data.count == resource.data.count - 1
            && exists(favoriteVoterPath(productId, request.auth.uid))
            && get(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid
            && !existsAfter(favoriteVoterPath(productId, request.auth.uid)))
        );
      allow delete: if false;
    }

    match /productFavorites/{productId}/voters/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && (
          (!exists(favoriteCountPath(productId))
            && existsAfter(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == 1)
          ||
          (exists(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count + 1)
        );
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && exists(favoriteCountPath(productId))
        && get(favoriteCountPath(productId)).data.count is int
        && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count - 1;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
