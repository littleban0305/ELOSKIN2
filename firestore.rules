rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function favoriteCountPath(productId) {
      return /databases/$(database)/documents/productFavoriteCounts/$(productId);
    }

    function favoriteVoterPath(productId, userId) {
      return /databases/$(database)/documents/productFavorites/$(productId)/voters/$(userId);
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "littleban0305@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /siteSettings/catalog {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["hiddenProductIds"])
        && request.resource.data.keys().hasAll(["hiddenProductIds"])
        && request.resource.data.hiddenProductIds is list
        && request.resource.data.hiddenProductIds.size() <= 2000;
      allow delete: if false;
    }

    match /siteSettings/faq {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["items"])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if false;
    }

    match /productOverrides/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && productId.size() <= 1000
        && request.resource.data.keys().hasOnly(["name", "price", "description"])
        && request.resource.data.keys().hasAll(["name", "price", "description"])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && (request.resource.data.price == null
          || (request.resource.data.price is int
            && request.resource.data.price >= 0
            && request.resource.data.price <= 10000000));
      allow delete: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["displayName", "tradeUrl"])
        && request.resource.data.keys().hasAll(["displayName", "tradeUrl"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.tradeUrl is string
        && request.resource.data.tradeUrl.matches("^https://steamcommunity\\.com/tradeoffer/new/\\?(partner=[0-9]+&token=[A-Za-z0-9_-]+|token=[A-Za-z0-9_-]+&partner=[0-9]+)$");
      allow delete: if false;
    }

    match /productFavoriteCounts/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && existsAfter(favoriteVoterPath(productId, request.auth.uid))
        && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && resource.data.count is int
        && (
          (request.resource.data.count == resource.data.count + 1
            && !exists(favoriteVoterPath(productId, request.auth.uid))
            && existsAfter(favoriteVoterPath(productId, request.auth.uid))
            && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid)
          ||
          (request.resource.data.count == resource.data.count - 1
            && exists(favoriteVoterPath(productId, request.auth.uid))
            && get(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid
            && !existsAfter(favoriteVoterPath(productId, request.auth.uid)))
        );
      allow delete: if false;
    }

    match /productFavorites/{productId}/voters/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && (
          (!exists(favoriteCountPath(productId))
            && existsAfter(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == 1)
          ||
          (exists(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count + 1)
        );
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && exists(favoriteCountPath(productId))
        && get(favoriteCountPath(productId)).data.count is int
        && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count - 1;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
