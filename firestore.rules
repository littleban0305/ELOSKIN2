rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function favoriteCountPath(productId) {
      return /databases/$(database)/documents/productFavoriteCounts/$(productId);
    }

    function favoriteVoterPath(productId, userId) {
      return /databases/$(database)/documents/productFavorites/$(productId)/voters/$(userId);
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "littleban0305@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /siteSettings/faq {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["items"])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if false;
    }

    function validListing(data) {
      return data.keys().hasOnly(["name", "game", "category", "description", "price", "stock", "tags", "imageUrl", "source", "steam", "listed", "createdAt", "updatedAt"])
        && data.keys().hasAll(["name", "game", "category", "description", "price", "stock", "tags", "imageUrl", "source", "listed", "createdAt"])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.game in ["CS2", "ROBLOX RIVALS", "OTHER"]
        && data.category is string && data.category.size() <= 30
        && data.description is string && data.description.size() <= 500
        && (data.price == null || (data.price is int && data.price >= 0 && data.price <= 10000000))
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && data.tags is list && data.tags.size() <= 10
        && data.imageUrl is string && data.imageUrl.size() <= 2048
        && (data.imageUrl == "" || data.imageUrl.matches("^https://.+"))
        && data.source in ["custom", "steam"]
        && data.listed is bool
        && data.createdAt is int;
    }

    match /listings/{listingId} {
      allow read: if resource.data.listed == true || isAdmin();
      allow create, update: if isAdmin() && validListing(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- 折價券、禮品券 ----------
    // coupons/{代碼}：管理員建立。知道代碼的人才讀得到（不能列出全部代碼）
    // userCoupons/{uid}_{代碼}：使用者領取的券；used = true 代表已經用在 orderId 這筆訂單

    function couponPath(code) {
      return /databases/$(database)/documents/coupons/$(code);
    }

    function userCouponPath(code) {
      return /databases/$(database)/documents/userCoupons/$(request.auth.uid + "_" + code);
    }

    function couponUsable(coupon) {
      return coupon.active == true && (coupon.expiresAt == 0 || request.time.toMillis() < coupon.expiresAt);
    }

    function validCoupon(data, code) {
      return data.keys().hasOnly(["code", "type", "title", "description", "imageUrl", "percent", "amount", "maxDiscount", "minSubtotal", "listingId", "listingName", "maxUses", "usedCount", "expiresAt", "active", "createdAt", "updatedAt"])
        && data.keys().hasAll(["code", "type", "title", "description", "imageUrl", "percent", "amount", "maxDiscount", "minSubtotal", "listingId", "listingName", "maxUses", "usedCount", "expiresAt", "active", "createdAt", "updatedAt"])
        && data.code == code && code.matches("^[A-Z0-9-]{4,24}$")
        && data.type in ["discount", "gift"]
        && data.title is string && data.title.size() > 0 && data.title.size() <= 40
        && data.description is string && data.description.size() <= 200
        && data.imageUrl is string && data.imageUrl.size() <= 2048 && (data.imageUrl == "" || data.imageUrl.matches("^https://.+"))
        && data.percent is int && data.percent >= 0 && data.percent <= 100
        && data.amount is int && data.amount >= 0 && data.amount <= 10000000
        && data.maxDiscount is int && data.maxDiscount >= 0
        && data.minSubtotal is int && data.minSubtotal >= 0
        && data.listingId is string && data.listingId.size() <= 100
        && data.listingName is string && data.listingName.size() <= 100
        && ((data.type == "gift" && data.listingId.size() > 0) || (data.type == "discount" && (data.percent > 0 || data.amount > 0)))
        && data.maxUses is int && data.maxUses >= 0
        && data.usedCount is int && data.usedCount >= 0
        && data.expiresAt is int
        && data.active is bool;
    }

    match /coupons/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validCoupon(request.resource.data, code);
      allow delete: if isAdmin();
      // 使用者領取：使用次數 +1，而且同一批寫入要建立自己的 userCoupons（每人限領一次）
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount"])
        && request.resource.data.usedCount == resource.data.usedCount + 1
        && (resource.data.maxUses == 0 || request.resource.data.usedCount <= resource.data.maxUses)
        && couponUsable(resource.data)
        && !exists(userCouponPath(code))
        && existsAfter(userCouponPath(code));
    }

    // 這張券用在 orderId 這筆訂單（同一批寫入建立的、自己的、couponCode 對得上）
    function couponOrderAfter(orderId, code) {
      return orderId is string && orderId.size() > 0 && orderId.size() <= 100
        && existsAfter(/databases/$(database)/documents/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.get("couponCode", "") == code;
    }

    match /userCoupons/{userCouponId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["uid", "code", "type", "used", "orderId", "redeemedAt", "usedAt"])
        && request.resource.data.keys().hasAll(["uid", "code", "type", "used", "orderId", "redeemedAt", "usedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string && request.resource.data.code.matches("^[A-Z0-9-]{4,24}$")
        && userCouponId == request.auth.uid + "_" + request.resource.data.code
        && getAfter(couponPath(request.resource.data.code)).data.usedCount == get(couponPath(request.resource.data.code)).data.usedCount + 1
        && request.resource.data.type == get(couponPath(request.resource.data.code)).data.type
        && request.resource.data.redeemedAt is int && request.resource.data.usedAt is int
        && ((request.resource.data.used == false && request.resource.data.orderId == "")
          || (request.resource.data.used == true && couponOrderAfter(request.resource.data.orderId, request.resource.data.code)));
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used", "orderId", "usedAt"])
          && request.resource.data.usedAt is int
          && ((resource.data.used == false && request.resource.data.used == true && couponOrderAfter(request.resource.data.orderId, resource.data.code))
            // 訂單取消後把券還回來
            || (resource.data.used == true && request.resource.data.used == false && request.resource.data.orderId == ""
              && getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.status == "cancelled")));
      allow delete: if false;
    }

    // 下單時用了券：券要能用、同一批寫入把自己的券標成用在這筆訂單；折扣不能超過券的上限
    function couponOrderOk(data, orderId) {
      let coupon = get(couponPath(data.couponCode)).data;
      let mine = userCouponPath(data.couponCode);
      return couponUsable(coupon)
        && (!exists(mine) || get(mine).data.used == false)
        && getAfter(mine).data.used == true
        && getAfter(mine).data.orderId == orderId
        && ((coupon.type == "discount" && data.type == "purchase"
            && data.subtotal is int && data.discount is int && data.discount > 0
            && data.total == data.subtotal - data.discount
            && data.subtotal >= coupon.minSubtotal
            && ((coupon.percent > 0 && data.discount <= data.subtotal * coupon.percent / 100 && (coupon.maxDiscount == 0 || data.discount <= coupon.maxDiscount))
              || (coupon.percent == 0 && data.discount <= coupon.amount)))
          || (coupon.type == "gift" && data.type == "gift"
            && data.total == 0 && data.offerTotal == 0 && data.get("discount", 0) == 0
            && data.items.size() == 1 && data.items[0].listingId == coupon.listingId && data.items[0].quantity == 1));
    }

    function couponFieldsOk(data, orderId) {
      return (data.get("couponCode", "") == "" && data.type != "gift" && data.get("discount", 0) == 0)
        || (data.get("couponCode", "") is string && data.get("couponCode", "") != "" && couponOrderOk(data, orderId));
    }

    function validOrderCreate(data, orderId) {
      return data.keys().hasOnly(["type", "uid", "buyerName", "tradeUrl", "items", "offerItems", "total", "offerTotal", "note", "adminNote", "status", "createdAt", "updatedAt", "subtotal", "discount", "couponCode"])
        && data.keys().hasAll(["type", "uid", "buyerName", "tradeUrl", "items", "offerItems", "total", "offerTotal", "note", "adminNote", "status", "createdAt", "updatedAt"])
        && data.type in ["purchase", "trade", "gift"]
        && data.uid == request.auth.uid
        && data.buyerName is string && data.buyerName.size() <= 30
        && data.tradeUrl is string && data.tradeUrl.size() <= 200
        && data.items is list && data.items.size() > 0 && data.items.size() <= 30
        && data.offerItems is list && data.offerItems.size() <= 20
        && (data.type == "trade" || data.offerItems.size() == 0)
        && data.total is int && data.total >= 0
        && data.offerTotal is int && data.offerTotal >= 0
        && data.note is string && data.note.size() <= 500
        && data.adminNote == ""
        && data.status == "pending"
        && data.createdAt is int && data.updatedAt is int;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && validOrderCreate(request.resource.data, orderId) && couponFieldsOk(request.resource.data, orderId);
      // 管理員可以改狀態、備註，以及「交給機器人」（botRequested = true、清掉 bot 讓機器人重送）；bot 的內容只有機器人能寫
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "adminNote", "updatedAt", "botRequested", "bot"])
          && request.resource.data.status in ["pending", "processing", "completed", "cancelled"]
          && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 300
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["botRequested"]) || request.resource.data.botRequested == true)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["bot"]) || request.resource.data.bot == null))
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "cancelled");
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["to", "from", "title", "body", "link", "orderId", "read", "createdAt"])
        && request.resource.data.keys().hasAll(["to", "from", "title", "body", "link", "orderId", "read", "createdAt"])
        && request.resource.data.from == request.auth.uid
        && (request.resource.data.to == "admin" || isAdmin())
        && request.resource.data.to is string && request.resource.data.to.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 300
        && request.resource.data.link is string && request.resource.data.link.size() <= 100
        && request.resource.data.orderId is string && request.resource.data.orderId.size() <= 100
        && request.resource.data.read == false
        && request.resource.data.createdAt is int;
      allow update: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read == true;
      allow delete: if request.auth != null
        && (resource.data.to == request.auth.uid || (resource.data.to == "admin" && isAdmin()));
    }

    match /wallets/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["balance", "updatedAt"])
        && request.resource.data.balance is int && request.resource.data.balance >= 0
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    match /walletTransactions/{entryId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["uid", "amount", "balanceAfter", "type", "refId", "note", "createdAt"])
        && request.resource.data.amount is int
        && request.resource.data.balanceAfter is int && request.resource.data.balanceAfter >= 0
        && request.resource.data.type in ["topup", "purchase", "trade", "adjust"]
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    match /topups/{topupId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["uid", "userName", "message", "requestedAmount", "attachmentCount", "status", "creditedAmount", "adminNote", "createdAt", "updatedAt"])
        && request.resource.data.keys().hasAll(["uid", "userName", "message", "requestedAmount", "attachmentCount", "status", "creditedAmount", "adminNote", "createdAt", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.requestedAmount is int && request.resource.data.requestedAmount >= 0
        && request.resource.data.attachmentCount is int && request.resource.data.attachmentCount >= 0 && request.resource.data.attachmentCount <= 3
        && request.resource.data.status == "pending"
        && request.resource.data.creditedAmount == 0
        && request.resource.data.adminNote == ""
        && request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "creditedAmount", "adminNote", "updatedAt"])
          && request.resource.data.status in ["pending", "approved", "rejected", "cancelled"]
          && request.resource.data.creditedAmount is int && request.resource.data.creditedAmount >= 0
          && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 300)
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "cancelled");
      allow delete: if false;

      match /attachments/{attachmentId} {
        allow read: if isAdmin()
          || (request.auth != null && get(/databases/$(database)/documents/topups/$(topupId)).data.uid == request.auth.uid);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/topups/$(topupId)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/topups/$(topupId)).data.status == "pending"
          && attachmentId in ["0", "1", "2"]
          && request.resource.data.keys().hasOnly(["dataUrl", "name", "createdAt"])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 900000
          && request.resource.data.dataUrl.matches("^data:image/(jpeg|png|webp);base64,.*")
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.createdAt is int;
        allow update, delete: if false;
      }
    }

    // Steam 綁定：由 Cloudflare Worker（服務帳戶）寫入，本人只能看自己的、可以解除
    match /steamLinks/{steamId} {
      allow read, create, update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /accountLinks/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if false;
    }

    // 每位使用者自己的 SteamAnalyst 金鑰，只有本人讀寫
    match /userSecrets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["steamAnalystKey", "updatedAt"])
        && request.resource.data.steamAnalystKey is string
        && request.resource.data.steamAnalystKey.size() <= 200
        && (request.resource.data.steamAnalystKey == "" || request.resource.data.steamAnalystKey.matches("^sa_[A-Za-z0-9_-]{8,190}$"))
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // 每位使用者讀到的 Steam 庫存，同步到不同裝置用，只有本人讀寫
    match /userInventories/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["steamId", "items", "savedAt"])
        && request.resource.data.steamId is string
        && request.resource.data.steamId.matches("^[0-9]{17}$")
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 1000
        && request.resource.data.savedAt is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 「我要讀庫存」的請求，由家裡手機上的中繼站（relay/relay.mjs，用管理員金鑰）處理後回寫
    // 文件 id 是 "admin" 的是管理頁上架用的請求，只有管理員能讀寫
    match /inventoryRequests/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || (userId == "admin" && isAdmin());
      allow create, update: if ((request.auth != null && request.auth.uid == userId) || (userId == "admin" && isAdmin()))
        && request.resource.data.keys().hasOnly(["steamId", "status", "message", "requestedAt", "startedAt", "finishedAt", "count", "total"])
        && request.resource.data.steamId is string
        && request.resource.data.steamId.matches("^[0-9]{17}$")
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt is int;
      allow delete: if false;
    }

    // 中繼站幫管理頁讀到的庫存（上架用）
    match /adminInventory/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 中繼站在線狀態，只有中繼站（管理員金鑰）能寫
    match /relayStatus/{relayId} {
      allow read: if true;
      allow write: if false;
    }

    // SteamAnalyst 查到的價格，大家共用；usd 為 0 代表查無此物品
    // 防亂填：只有自己設定了 SteamAnalyst 金鑰的人能寫、時間要是現在、12 小時內別人查過的不能蓋掉（管理員可以）
    function hasPriceKey() {
      return exists(/databases/$(database)/documents/userSecrets/$(request.auth.uid))
        && get(/databases/$(database)/documents/userSecrets/$(request.auth.uid)).data.steamAnalystKey.size() > 0;
    }

    match /marketPrices/{priceId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != "anonymous"
        && hasPriceKey()
        && request.resource.data.keys().hasOnly(["name", "usd", "source", "updatedAt", "updatedBy"])
        && request.resource.data.keys().hasAll(["name", "usd", "source", "updatedAt", "updatedBy"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 300
        && request.resource.data.usd is number
        && request.resource.data.usd >= 0
        && request.resource.data.usd <= 1000000
        && request.resource.data.source == "steamanalyst"
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt > request.time.toMillis() - 300000
        && request.resource.data.updatedAt < request.time.toMillis() + 300000
        && request.resource.data.updatedBy == request.auth.uid
        && (resource == null
          || isAdmin()
          || resource.data.updatedBy == request.auth.uid
          || resource.data.updatedAt < request.time.toMillis() - 43200000);
      allow delete: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["displayName", "tradeUrl"])
        && request.resource.data.keys().hasAll(["displayName", "tradeUrl"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.tradeUrl is string
        && request.resource.data.tradeUrl.matches("^https://steamcommunity\\.com/tradeoffer/new/\\?(partner=[0-9]+&token=[A-Za-z0-9_-]+|token=[A-Za-z0-9_-]+&partner=[0-9]+)$");
      allow delete: if false;
    }

    match /productFavoriteCounts/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && existsAfter(favoriteVoterPath(productId, request.auth.uid))
        && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(["count"])
        && request.resource.data.count is int
        && resource.data.count is int
        && (
          (request.resource.data.count == resource.data.count + 1
            && !exists(favoriteVoterPath(productId, request.auth.uid))
            && existsAfter(favoriteVoterPath(productId, request.auth.uid))
            && getAfter(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid)
          ||
          (request.resource.data.count == resource.data.count - 1
            && exists(favoriteVoterPath(productId, request.auth.uid))
            && get(favoriteVoterPath(productId, request.auth.uid)).data.uid == request.auth.uid
            && !existsAfter(favoriteVoterPath(productId, request.auth.uid)))
        );
      allow delete: if false;
    }

    match /productFavorites/{productId}/voters/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && (
          (!exists(favoriteCountPath(productId))
            && existsAfter(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == 1)
          ||
          (exists(favoriteCountPath(productId))
            && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count + 1)
        );
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && exists(favoriteCountPath(productId))
        && get(favoriteCountPath(productId)).data.count is int
        && getAfter(favoriteCountPath(productId)).data.count == get(favoriteCountPath(productId)).data.count - 1;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
